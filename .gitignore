# Ignore all files under Assets/Sprites/External except .meta files
/Assets/Sprites/External/**
!/Assets/Sprites/External/**/*.meta

# (삭제) 에이전트 가이드/워크로그는 버전에 포함

# Unity local/derived folders (do not commit)
/Library/
/Temp/
/Logs/
/UserSettings/

# Common build artifacts
/Build/
/Builds/
/Obj/

# Generated assets (do not commit)
/GeneratedAssets/
/GeneratedAssets_deleted/

# 문서(로컬 계획서) 무시
REFACTORING_PLAN.MD

# Ignore all files under Assets/Audio except .meta files
/Assets/Audio/**
!/Assets/Audio/**/*.meta
!/Assets/Audio/*.meta

# Burst 디버그 정보 폴더(자동 생성, 배포 금지)
/GeoHelio_BurstDebugInformation_DoNotShip/
/*_BurstDebugInformation_DoNotShip/

# 로컬 임시 작업 폴더(커밋 제외)
/.utmp/

# Unity가 생성하는 백업 폴더(자동 생성, 배포/커밋 금지)
/GeoHelio_BackUpThisFolder_ButDontShipItWithYourGame/
/*_BackUpThisFolder_ButDontShipItWithYourGame/
